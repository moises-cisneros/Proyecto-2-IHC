# Copy to .env to override defaults used by docker-compose.yml.
# All values below are development defaults; do not reuse them in production.

POSTGRES_USER=planazo
POSTGRES_PASSWORD=planazo
POSTGRES_DB=planazo_db

# Secret used to sign session JWTs (inside the backend container).
JWT_SECRET=dev-only-change-me

# Used ONLY when running Prisma commands from the host machine
# (for example `pnpm seed` or `pnpm --filter backend prisma migrate dev`).
# The db service publishes port 5432 on localhost.
DATABASE_URL=postgresql://planazo:planazo@localhost:5432/planazo_db?schema=public
