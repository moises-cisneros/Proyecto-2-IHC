# Copia esto a .env para sobrescribir la configuración predeterminada utilizada por docker-compose.yml.

# Credenciales de la base de datos PostgreSQL
POSTGRES_USER=planazo
POSTGRES_PASSWORD=planazo
POSTGRES_DB=planazo_db
JWT_SECRET=dev-only-change-me
DATABASE_URL=postgresql://planazo:planazo@localhost:5432/planazo_db?schema=public

# Configuración de Correo Electrónico (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Planazo Soporte" <no-reply@planazo.com>
